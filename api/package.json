{
  "name": "study-library-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "lint": "oxlint .",
    "test": "tsx --test tests/*.test.ts",
    "deps:audit": "pnpm audit --prod",
    "catalog:sync": "tsx src/sync-cli.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "marked": "^18.0.14",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  }
}
