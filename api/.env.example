# Study Library API. Copy to .env for local development. Never commit real values; production values live in the host's secret store.
NODE_ENV=development
PORT=4450

# Supabase project (server-side only). The service-role key bypasses row-level security: it must never reach a browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=study-library

# The one web origin allowed to call this API with credentials (an origin only: no path, https in production).
WEB_ORIGIN=http://localhost:4444

# Shared access password (required in production, at least 12 characters) and a separate signing secret
# (required in production, at least 32 bytes, never the password). Generate one with: openssl rand -base64 48
LIBRARY_ACCESS_PASSWORD=
SESSION_SECRET=

# Token for POST /api/catalog/sync (at least 32 bytes). Leave empty to switch that route off.
CATALOG_SYNC_TOKEN=

# Reverse proxies in front of the service (Render has one). Decides which address counts as the client for rate limits.
TRUST_PROXY_HOPS=0
# lax, strict or none. Production defaults to none because the web page and this API are on different sites; if both
# share one registrable domain (library.example.com and api.example.com), use lax.
# API_COOKIE_SAMESITE=lax
# MAX_UPLOAD_BYTES=104857600
