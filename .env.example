# Local development
NODE_ENV=development
PORT=4445
STORAGE_MODE=filesystem
STUDY_CONTENT_DIR=./study-content
MAX_UPLOAD_BYTES=104857600
# Folder the Watch and Music tabs read local video/audio from (scanned recursively, read-only, one folder only).
# On Windows it defaults to the root of drive G: and must stay on that drive; anything else is refused. Keep it commented out here:
# an empty value would point at the project folder. Elsewhere it defaults to ./data/watch.
# WATCH_MEDIA_DIR=G:/media
# The one drive letter media may come from (Windows only). Change it together with WATCH_MEDIA_DIR.
# WATCH_ALLOWED_DRIVE=G
# Watch also needs ffmpeg and ffprobe: set FFMPEG_PATH to their folder, or put them in .tools/ffmpeg/bin, or on PATH.
# FFMPEG_PATH=C:/tools/ffmpeg/bin
# Where the Watch catalog (catalog.json), pictures and hover previews are kept.
# WATCH_CATALOG_DIR=./data/watch-catalog
# Simultaneous file conversions (1 to 8), and "lazy" to make hover previews only when first hovered.
# WATCH_MAX_STREAMS=3
# WATCH_PREVIEWS=lazy
# H.264 encoder for converted streams: x264 (default) or amf (AMD hardware, only when ffmpeg has it).
# WATCH_ENCODER=x264

# Optional separate REST API service. Leave empty for same-origin local mode.
API_ORIGIN=
# Only for a split deployment: the one web origin (https, no path) allowed to post to the practice runner.
WEB_ORIGIN=

# Hosted mode: set STORAGE_MODE=supabase and keep these values server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=study-library

# Shared-password ("owner") mode, used only with AUTH_MODE=owner. In production SESSION_SECRET is required, must be at
# least 32 bytes and must not be the password (it signs the sign-in cookie).
LIBRARY_ACCESS_PASSWORD=
SESSION_SECRET=

# Optional OpenAI-compatible upload classifier. Never expose these secrets in client build variables.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Account identity. The current adapter is local SQLite, independent of content storage.
AUTH_MODE=accounts
AUTH_IDENTITY_STORE=sqlite
# Open the app at exactly this address. Cookies are per host, so 127.0.0.1 would not share this sign-in.
AUTH_PUBLIC_ORIGIN=http://localhost:4444
# Generate a server-only random secret; required in HTTPS production (at least 32 bytes).
AUTH_SESSION_SECRET=
# Signup is open locally, closed by default in production. Enable deliberately for shared libraries.
AUTH_SIGNUP_ENABLED=true
# Set trusted proxy IPs/CIDRs or loopback only; the proxy must overwrite forwarded headers.
AUTH_TRUST_PROXY=0

# Configure registered OAuth applications; no credentials belong in client variables.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4444/api/auth/oauth/google/callback
MICROSOFT_LOGIN_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:4444/api/auth/oauth/microsoft/callback
MICROSOFT_TENANT_ID=consumers
FACEBOOK_LOGIN_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4444/api/auth/oauth/facebook/callback
# Set the supported Graph API version from the Meta app dashboard before enabling.
FACEBOOK_GRAPH_VERSION=

# Optional verification/reset email adapter. Keep API key on the server only.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Production accounts require a durable single-instance SQLite disk acknowledgement.
# PostgreSQL/Supabase identity adapters are not installed; never use ephemeral hosting for identities.
AUTH_ALLOW_PERSISTENT_SQLITE=false

# Development listeners bind loopback by default. Change only for a deliberate private-network setup.
STUDY_SERVER_HOST=127.0.0.1
STUDY_WEB_HOST=127.0.0.1
