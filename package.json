{
  "name": "study-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k \"webpack serve --mode development\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && pnpm typecheck:server && webpack --mode production && node scripts/precompress.mjs",
    "start": "pnpm build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "storage:seed": "node scripts/seed-supabase.mjs",
    "typecheck": "tsc -b && pnpm typecheck:server",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "lint": "oxlint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "deps:audit": "pnpm audit --prod",
    "audit:standards": "node scripts/audit-standards.mjs",
    "preview": "webpack serve --mode production --host 0.0.0.0 --port 4444",
    "dev:local": "node scripts/dev-local.mjs",
    "courses:generate": "node scripts/generate-study-courses.mjs",
    "courses:validate": "tsx scripts/validate-study-courses.ts",
    "motion:generate": "tsx scripts/generate-motion.ts",
    "test:learning": "tsx --tsconfig tsconfig.app.json --test tests/learning/*.test.ts tests/learning/*.test.tsx",
    "test:auth": "tsx --tsconfig tsconfig.app.json --test tests/auth/*.test.ts tests/auth/*.test.tsx",
    "test:markdown": "tsx --tsconfig tsconfig.app.json --test tests/markdown/*.test.ts tests/markdown/*.test.tsx",
    "test:watch": "tsx --tsconfig tsconfig.app.json --test tests/watch/*.test.ts",
    "test:music": "tsx --tsconfig tsconfig.app.json --test tests/music/*.test.ts",
    "test:motion": "tsx --tsconfig tsconfig.app.json --test tests/motion/*.test.ts*",
    "test:server": "tsx --tsconfig tsconfig.server.json --test tests/server/*.test.ts",
    "test:security": "tsx --tsconfig tsconfig.app.json --test tests/security/*.test.ts",
    "test:auth:live": "node scripts/smoke-auth.mjs",
    "test:build": "node --test tests/build/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "compression": "^1.8.2",
    "epubjs": "^0.3.93",
    "express": "^5.3.0",
    "jose": "6.2.12",
    "jszip": "^3.10.2",
    "lenis": "^1.3.27",
    "libphonenumber-js": "1.13.14",
    "lucide-react": "1.48.0",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pngjs": "7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@biomejs/biome": "^2.6.3",
    "@testing-library/react": "16.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/pdf-parse": "^1.1.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "babel-loader": "^10.1.1",
    "concurrently": "^10.0.5",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "26.1.0",
    "mini-css-extract-plugin": "^2.10.2",
    "oxlint": "^1.81.0",
    "style-loader": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "packageManager": "pnpm@11.28.3"
}
